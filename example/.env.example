# The Laravel app running m0d1xd/expo-notification, reachable from the phone (use your machine's LAN IP).
EXPO_PUBLIC_API_URL=http://192.0.2.10:8000
# Log the client's requests and events to the Metro console in release builds too.
EXPO_PUBLIC_PUSH_DEBUG=0

# Your EAS project (expo.dev → project → ID). Push tokens need it.
EAS_PROJECT_ID=
EXPO_OWNER=
# Must match the package registered in your Firebase project / google-services.json.
ANDROID_PACKAGE=com.example.exponotificationclient
